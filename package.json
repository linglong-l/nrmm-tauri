{
  "name": "nrmm-tauri",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "ts:check": "tsc --noEmit",
    "vue:check": "vue-tsc --noEmit",
    "tsc:strict": "tsc --noEmit --strict",
    "biome:check": "pnpm dlx biome check .",
    "build:linux": "bash scripts/build-linux-gnu.sh",
    "build:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "element-plus": "^2",
    "pinia": "^4",
    "vue": "^3",
    "vue-i18n": "^11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "~6.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3"
  }
}
