{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NRMM",
  "version": "0.4.0",
  "identifier": "com.ye.nrmm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NRMM",
        "width": 960,
        "height": 640,
        "minWidth": 750,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "resizable": true,
        "focus": true,
        "focusable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.png",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.webp",
          "**/*.bmp",
          "**/*.gif"
        ]
      }
    }
  }
}
