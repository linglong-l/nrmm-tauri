{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nrmm-tauri",
  "version": "0.5.0",
  "identifier": "com.ye.nrmm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NRMM-Tauri",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,WinUseBrowserSpellChecker,Translate,AutofillServerCommunication,MediaRouter,OptimizationGuide,InterestFeedContentSuggestions,BackgroundFetch,PushMessaging,SpareRendererForSitePerProcess --mute-audio --disable-extensions",
        "width": 960,
        "height": 640,
        "minWidth": 750,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*.png",
            "**/*.jpg",
            "**/*.jpeg",
            "**/*.webp",
            "**/*.bmp",
            "**/*.gif",
            "**/*.ico"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  }
}
