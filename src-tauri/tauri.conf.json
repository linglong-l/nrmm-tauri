{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nrmm-rust",
  "version": "0.3.0",
  "identifier": "com.ye.nrmm-rust",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nrmm-rust",
        "width": 900,
        "height": 650,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "resizable": true,
        "minWidth": 750,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/api/v5/repos/ye215/xxmi-nrmm/releases/latest"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4ODVCNkZDQzlBQTZEM0QKUldROWJhckovTGFGU0JhTFhHd0xEQUhUVFlzUEg2M2hTdlN6TmQ2bE5WMlZtYkdQYjQwUnozNE0K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "rpm"],
    "linux": {
      "deb": {},
      "appimage": {},
      "rpm": {}
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
