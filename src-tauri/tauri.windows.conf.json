{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NRMM",
  "version": "0.4.0",
  "identifier": "com.ye.nrmm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.png",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.webp",
          "**/*.bmp",
          "**/*.gif"
        ]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4ODVCNkZDQzlBQTZEM0QKUldROWJhckovTGFGU0JhTFhHd0xEQUhUVFlzUEg2M2hTdlN6TmQ2bE5WMlZtYkdQYjQwUnozNE0K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"]
      },
      "wix": {
        "language": {
          "en-US": {},
          "zh-CN": {}
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
