[KeySwapExpressTicket]
key = no_alt no_ctrl NUMPAD2
condition = ($active == 1) && $managed_slot_id == $\modmanageragl\group_1\active_slot
type = cycle
$ticket = 0,1

[KeySwapPhoneTexture]
key = no_alt no_ctrl NUMPAD3
condition = ($active == 1) && $managed_slot_id == $\modmanageragl\group_1\active_slot
type = cycle
$phone = 0,1

[Present]
if $managed_slot_id == $\modmanageragl\group_1\active_slot
    post $active = 0
endif

